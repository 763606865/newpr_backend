# .env.testing.example - copy to .env.testing and fill secrets
APP_ENV=testing
APP_KEY=base64:ReplaceWithYourKey

# Example MySQL test database - update to match your CI or local test DB
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=test_db
DB_USERNAME=test_user
DB_PASSWORD=secret

# Cache / Queue / Mail defaults for tests
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

# Keep other test-friendly defaults
BCRYPT_ROUNDS=4
SESSION_DRIVER=array
SCOUT_DRIVER=collection
