APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_TIMEZONE=Asia/Shanghai
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=niupr
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_MAPS_API_KEY=
AMAP_WEB_API_KEY=

# 聚才APi
JUCAI_HOST=
JUCAI_ACCESSKEY=

# 聚才数据中台APi
JUCAI_DT_HOST=
JUCAI_DT_APP_KEY=
JUCAI_DT_APP_SECRET=
JUCAI_DT_CACHE_STORE=

# 短信配置
SMS_DRIVER=
SMS_JUCAI_USERNAME=
SMS_JUCAI_PASSWORD=
SMS_JUCAI_TEMPLATE_ID=

# 开发人员账户
APP_SKIP_ACCOUNTS=

# Aliyun OSS
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_DEFAULT_REGION=
OSS_BUCKET=
OSS_ENDPOINT=

# Aliyun OCR（默认复用 OSS AccessKey）
OCR_DRIVER=aliyun
OCR_ACCESS_KEY_ID=
OCR_ACCESS_KEY_SECRET=
OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com
OCR_REGION_ID=cn-hangzhou

SCOUT_DRIVER=elastic
SCOUT_QUEUE=true
ELASTIC_HOST=http://127.0.0.1:9200
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=你的ES密码

AMAP_KEY=

# SApi
SAPI_PAGINATION_ENABLED=true

# IM
IM_DRIVER=
IM_END_POINT=
IM_APP_CODE=
IM_APP_KEY=
IM_APP_SECRET=
